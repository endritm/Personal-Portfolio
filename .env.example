# Copy to .env.local. Everything is optional: without Sanity the site runs on seed content.

# Public URL, used for the sitemap and share images
NEXT_PUBLIC_SITE_URL=https://example.com

# Sanity (sanity.io/manage → your project)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01

# Shared secret for the Sanity webhook that refreshes the site on publish (/api/revalidate)
SANITY_REVALIDATE_SECRET=

# Contact form, sent with Resend (resend.com). Without these the form says so and shows the email.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Portfolio <hello@your-domain.com>"
